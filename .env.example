POSTGRES_PORT=5433 # Docker postgres host porti (host 5432 bilan toqnashmaslik uchun, ozgartirish mumkin)
POSTGRES_DB=warehouse_db # PostgreSQL database nomi
POSTGRES_USER=mexa # PostgreSQL foydalanuvchisi
POSTGRES_PASSWORD=mexa1234 # PostgreSQL paroli (dev)

JWT_SECRET=replace-with-at-least-32-byte-random-secret # Barcha JWT imzolash uchun umumiy secret
JWT_EXPIRATION_MS=86400000 # Access token muddati (ms)
APP_INTERNAL_SECRET=replace-with-strong-internal-secret # Servicelararo internal API chaqiriqlar uchun secret

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/warehouse_db # Lokal ishga tushirish uchun default datasource URL

# payment-service (Payme): avval DB yarating — CREATE DATABASE payments_db;
PAYMENT_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/payments_db
PAYMENT_SERVER_PORT=8091
PAYME_MERCHANT_ID=
PAYME_TEST_KEY=
PAYME_PROD_KEY=
PAYME_ACTIVE_KEY=test
PAYME_CHECKOUT_URL=https://checkout.paycom.uz/
PAYME_CALLBACK_PATH=/payment/payme/callback
PAYME_TIMEOUT_MS=12000

# Gateway → payment-service (Docker tarmog'i: http://payment-service:8091)
PAYMENT_SERVICE_URL=http://localhost:8091
SPRING_DATASOURCE_USERNAME=mexa # Lokal datasource username
SPRING_DATASOURCE_PASSWORD=mexa1234 # Lokal datasource password
AUTH_SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/auth_db # auth-service datasource URL (dedicated auth_db)
PRODUCT_SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/products_db # product-service datasource URL
ORDER_SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/warehouse_db # order-service datasource URL
NOTIFICATION_SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/warehouse_db # notification-service datasource URL
DELIVERY_SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/warehouse_db # delivery-service datasource URL

APP_SWAGGER_BASIC_AUTH_ENABLED=false # Swagger basic auth yoqish/o'chirish
APP_SWAGGER_USERNAME=swagger # Swagger login username
APP_SWAGGER_PASSWORD=change-me-now # Swagger login password
AUTH_SPRING_PROFILES_ACTIVE=default # auth-service profile
PRODUCT_SPRING_PROFILES_ACTIVE=default # product-service profile
SHOP_SPRING_PROFILES_ACTIVE=default # shop-service profile
SHOP_APP_SWAGGER_ENABLED=true # shop-service Swagger yoqilgan holati
# shop-service JPA (cart, wishlist, addresses) — Flyway: shop_* jadvallari warehouse_db yoki alohida DBda
SHOP_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/warehouse_db

APP_STORAGE_TYPE=minio # Fayl saqlash turi (minio/s3/local)
APP_STORAGE_ROOT=storage # Lokal storage root papkasi
APP_STORAGE_MINIO_ENDPOINT=http://minio:9000 # MinIO endpoint
APP_STORAGE_MINIO_ACCESS_KEY=minioadmin # MinIO access key
APP_STORAGE_MINIO_SECRET_KEY=minioadmin # MinIO secret key
APP_STORAGE_MINIO_BUCKET=product-images # MinIO bucket nomi
APP_STORAGE_MINIO_PUBLIC_BASE_URL= # MinIO public URL (ixtiyoriy)
APP_STORAGE_S3_ENDPOINT= # S3 endpoint (ixtiyoriy)
APP_STORAGE_S3_ACCESS_KEY= # S3 access key
APP_STORAGE_S3_SECRET_KEY= # S3 secret key
APP_STORAGE_S3_BUCKET=product-images # S3 bucket nomi
APP_STORAGE_S3_PUBLIC_BASE_URL= # S3 public URL (ixtiyoriy)

MINIO_ROOT_USER=minioadmin # MinIO root foydalanuvchi
MINIO_ROOT_PASSWORD=minioadmin # MinIO root parol

AUTH_SERVICE_URL=http://auth-service:8081 # Auth service ichki URL
PRODUCT_SERVICE_URL=http://product-service:8083 # Product service ichki URL
SHOP_SERVICE_URL=http://shop-service:8094 # Shop service ichki URL
WAREHOUSE_SERVICE_URL=http://host.docker.internal:8084 # Warehouse service ichki URL
ORDER_SERVICE_URL=http://order-service:8085 # Order service ichki URL
NOTIFICATION_SERVICE_URL=http://notification-service:8087 # Notification service ichki URL
DELIVERY_SERVICE_URL=http://delivery-service:8088 # Delivery service ichki URL
REPORT_SERVICE_URL=http://report-service:8089 # Report service ichki URL
SEARCH_SERVICE_URL=http://search-service:8090 # Search service ichki URL
CATALOG_SERVICE_URL=http://catalog-service:8086 # Catalog/reference-data service ichki URL
GATEWAY_PRODUCT_SERVICE_URL=http://product-service:8083 # Gateway ichida product-service URL
REFERENCE_DATA_SERVICE_URL=http://catalog-service:8086 # Product uchun reference-data (catalog) URL
PRODUCT_SERVICE_TIMEOUT_MS=3000 # Product service so'rovi timeout (ms)
APP_WAREHOUSE_DEFAULT_ID=00000000-0000-0000-0000-000000000001 # order-service uchun default warehouse UUID

MAIL_USERNAME= # SMTP username (notification-service)
MAIL_PASSWORD= # SMTP password (notification-service)
ESKIZ_EMAIL= # Eskiz akkaunt email/login
ESKIZ_PASSWORD= # Eskiz akkaunt paroli
ESKIZ_SENDER= # Eskiz sender nomi yoki alfasender

ES_URIS=http://elasticsearch:9200 # Elasticsearch URI ro'yxati (vergul bilan)
ES_USERNAME= # Elasticsearch username (agar security yoqilgan bo'lsa)
ES_PASSWORD= # Elasticsearch password (agar security yoqilgan bo'lsa)
ELASTIC_PASSWORD= # Elasticsearch built-in elastic user paroli (ixtiyoriy/devda bo'sh qoldirish mumkin)

REDIS_HOST=redis # Redis host
REDIS_PORT=6379 # Redis port
GATEWAY_RATE_LIMIT_REPLENISH_RATE=20 # Gateway rate limiter replenish rate
GATEWAY_RATE_LIMIT_BURST_CAPACITY=40 # Gateway rate limiter burst capacity
GATEWAY_CORS_ALLOWED_ORIGIN_1=http://localhost:3000 # Gateway CORS allowed origin #1
GATEWAY_CORS_ALLOWED_ORIGIN_2=http://localhost:5173 # Gateway CORS allowed origin #2
WAREHOUSE_SERVER_PORT=8084 # warehouse-service tashqi porti (lokal)

# Discount Service
DISCOUNT_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/discounts_db
DISCOUNT_SERVICE_URL=http://localhost:8092

# Analytics Service
ANALYTICS_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/analytics_db
ANALYTICS_SERVICE_URL=http://localhost:8096
ANALYTICS_CACHE_TTL_MINUTES=5
ANALYTICS_LOW_STOCK_THRESHOLD=10

# Geo Service
GEO_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/geo_db
GEO_SERVICE_URL=http://localhost:8095

